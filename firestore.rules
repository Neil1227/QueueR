rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User root document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Cards subcollection
      match /cards/{cardId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        
        allow create, update: if request.auth != null 
          && request.auth.uid == userId
          && request.resource.data.provider is string
          && request.resource.data.provider.size() > 0
          && request.resource.data.provider.size() <= 50
          && request.resource.data.color is string
          && request.resource.data.color.matches('^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{3})$')
          && request.resource.data.isDefault is bool
          && (
            !('imgB64' in request.resource.data) ||
            request.resource.data.imgB64 == null ||
            (request.resource.data.imgB64 is string && request.resource.data.imgB64.size() < 250000)
          );
      }

      // Metadata subcollection (for E2EE salt and settings)
      match /meta/{metaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: false;
    }
  }
}
